# Bot token from https://discord.com/developers/applications -> your app -> Bot
DISCORD_TOKEN=your-bot-token-here

# Application (Client) ID from the "General Information" tab of your app
CLIENT_ID=your-application-client-id

# From console.upstash.com -> your database -> REST API section.
# Required so tracked people, watch later lists and sign-ins survive restarts.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: a Discord server ID for instant command registration while testing.
GUILD_ID=

# How often (in minutes) the bot checks Simkl for new watches
POLL_MINUTES=3

# Name of the server role pinged once when the bot restarts (case-insensitive).
PING_ROLE_NAME=tv

# ---- Simkl (movies and TV, required for /signin, /track and /find) ----
# Create an app at https://simkl.com/settings/developer and paste its Client ID.
# You can reuse the Client ID from your Simkl bot. Device sign-in must be
# allowed for the app. No redirect URL is needed.
SIMKL_CLIENT_ID=

# ---- Developer Dashboard (served at /dashboard on your bot's URL) ----

# Required. The shared password for logging into the dashboard.
DASHBOARD_PASSWORD=

# Required for logins to survive a restart. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DASHBOARD_SESSION_SECRET=

# Optional. Enables the "Redeploy" button. Render: Settings -> Deploy Hook.
RENDER_DEPLOY_HOOK_URL=

# Optional. Discord channel ID the dashboard's Feedback tab reads from.
FEEDBACK_CHANNEL_ID=

# Optional. Your bot's public base URL (no trailing slash).
PUBLIC_URL=
